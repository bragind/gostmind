# GOSTMind Configuration

# Application
APP_NAME=GOSTMind
DEBUG=false
ENVIRONMENT=production
LOG_LEVEL=INFO

# Security
API_KEY=change-me-to-secure-key
CORS_ORIGINS=*

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/gostmind

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_DEFAULT=3600

# Vector Store
CHROMA_PATH=./data/chroma
VECTOR_STORE_COLLECTION=gosts

# LLM (Ollama)
# Для работы внутри Docker сети используйте: http://ollama:11434
# Для работы с хоста используйте: http://localhost:11434
LLM_BASE_URL=http://ollama:11434
LLM_MODEL=llama3
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1000
LLM_TIMEOUT=120.0

# Embeddings (Ollama)
# Для работы внутри Docker сети используйте: http://ollama:11434
# Для работы с хоста используйте: http://localhost:11434
EMBEDDING_BASE_URL=http://ollama:11434
EMBEDDING_MODEL=nomic-embed-text

# RAG Settings
RAG_TOP_K=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Rate Limiting
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW=60

# Storage
DOCUMENTS_PATH=./data/gosts
